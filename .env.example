# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored — never commit real keys.
#
#    cp .env.example .env

# ── 智谱 GLM（战争 / 人物生成的默认通道）────────────────────────────────────
# https://open.bigmodel.cn/  → API Keys
# generate-wars.mjs 与 generate-profiles.js 会在这 5 个 key 间轮换；
# 某个 key 报“余额不足（code 1113）”时会被自动移出本次轮换。
ZHIPU_API_KEY_1=
ZHIPU_API_KEY_2=
ZHIPU_API_KEY_3=
ZHIPU_API_KEY_4=
ZHIPU_API_KEY_5=

# ── OpenAI 兼容的备用通道 ───────────────────────────────────────────────────
# 智谱额度耗尽时的兜底。BASE_URL 可填主机名、基路径或完整端点：
#   https://your-host
#   https://your-host/v1
#   https://your-host/v1/chat/completions
OPEN_API_KEY=
OPEN_BASE_URL=

# ── DeepSeek 官方 ──────────────────────────────────────────────────────────
# 供翻译与描述生成脚本使用。
DEEPSEEK_API_KEY=

# ── 通义千问（可选，人物生成的补充通道）────────────────────────────────────
QWEN_API_KEY=

# ── Cesium Ion（可选）──────────────────────────────────────────────────────
# 当前实现不加载 Ion 资源（影像与地球均为自建），因此不填也能正常运行。
# 若将来需要 Ion 提供的地形或影像，请使用 VITE_ 前缀，前端只读取该前缀。
VITE_CESIUM_TOKEN=
